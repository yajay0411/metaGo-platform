{
  "root": true,
  "extends": ["eslint:recommended", "plugin:react-hooks/recommended"],
  "plugins": ["react-hooks", "react-refresh"],
  "env": {
    "browser": true,
    "node": true,
    "es2020": true
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "rules": {
    "react-refresh/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  }
}
